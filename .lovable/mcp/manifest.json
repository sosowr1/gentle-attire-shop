{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "noora-mcp",
      "version": "0.1.0",
      "title": "Noora — Modest Fashion"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List all product categories available in the Noora storefront.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List Noora products. Optionally filter by category and/or maximum price.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Restrict results to one category.",
              "type": "string",
              "enum": [
                "Abayas",
                "Hijabs",
                "Ensembles",
                "Accessoires"
              ]
            },
            "maxPrice": {
              "description": "Only include products at or below this price (EUR).",
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Get full details for a single Noora product by its id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The product id (e.g. 'abaya-soie-medine')."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
